# API Configuration
NEXT_PUBLIC_API_URL=https://api.example.com

# RPC Provider
NEXT_PUBLIC_INFURA_API_KEY=your_infura_api_key_here

# WalletConnect (optional)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# The Graph API Key (for codegen and subgraph queries)
THEGRAPH_API_KEY=your_thegraph_api_key_here

# Blend / Stellar — Soroban RPC endpoint.
# Unset falls back to the free public https://mainnet.sorobanrpc.com, which
# rate-limits (429) partway through a full adapter run. Point this at a
# dedicated provider in production.
BLEND_RPC=https://mainnet.sorobanrpc.com
# Minimum gap between two Soroban RPC calls, in ms. This is what keeps the
# adapter under the endpoint's rate limit — there is no in-process retry, a
# refused call fails the job and QStash re-runs it.
#
# 80 ms suits a 15 req/s endpoint (measured peak: 10 req/s). Budget per full
# cycle, measured at the fetch layer: spot 32 requests (v1) + 41 (v2) every
# 10 min, products 16 + 15 hourly = ~11,300 requests/day for both versions.
# Check that against the plan's daily cap before lowering this.
BLEND_RPC_MIN_INTERVAL_MS=80
# Blend Backstop contract addresses — the reward zone read to discover pools.
# Unset means an empty address and zero pools discovered, silently.
NEXT_PUBLIC_BACKSTOP_V1=
NEXT_PUBLIC_BACKSTOP_V2=

# Yield Optimizer API
OPTIMIZER_API_URL=https://optimizer.lendwise.fi

# PostgreSQL (Neon) — pooled URL for the app runtime
DATABASE_URL=postgres://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# PostgreSQL (Neon) — direct (unpooled) URL for drizzle-kit migrations
DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Upstash Redis — rate limiting for the PUBLIC endpoints (/api/graphql, /api/optimizer).
# Optional locally and in CI: when unset, the limiter is a no-op that allows every
# request. REQUIRED in production — without it both public endpoints run with no
# rate limit at all (the app logs an error on boot but still serves, by design:
# availability outranks enforcement).
UPSTASH_REDIS_REST_URL=https://<name>-<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# QStash — signature verification for the cron-driven pipeline. Every /api/yield/*
# job verifies the incoming request against these keys and returns 401 without
# them, so an unset pair means the whole APY pipeline silently stops ingesting.
# Both are required: QStash rotates between current and next.
# Copy them from the Upstash console → QStash → Request Builder / Signing keys.
QSTASH_CURRENT_SIGNING_KEY=sig_xxxx
QSTASH_NEXT_SIGNING_KEY=sig_xxxx
