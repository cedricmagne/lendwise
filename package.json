{
  "name": "lendwise",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "pnpx only-allow pnpm",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "dotenv -- drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "products:sync": "dotenv -- tsx scripts/products-sync.ts",
    "adapter:test": "dotenv -- tsx scripts/adapter-test.ts",
    "collect:apy": "dotenv -- tsx scripts/collect-apy.ts",
    "fix:daily-nan": "dotenv -- tsx scripts/fix-daily-nan.ts",
    "clean:non-finite-apy": "dotenv -- tsx scripts/clean-non-finite-apy.ts",
    "clean:reward-spikes": "dotenv -- tsx scripts/clean-reward-spikes.ts",
    "clean:stale-heals": "dotenv -- tsx scripts/clean-stale-heals.ts",
    "fix:availability": "dotenv -- tsx scripts/fix-availability-overshoot.ts",
    "dev": "next dev",
    "build": "pnpm codegen && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "rm -rf node_modules pnpm-lock.yaml .next",
    "clean:cache": "rm -rf .next",
    "reinstall": "pnpm clean && pnpm install",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:clean": "find src -type d -name 'generated' -exec rm -rf {} + 2>/dev/null || true && pnpm codegen",
    "codegen:optimizer": "dotenv -- bash -c 'openapi-typescript $OPTIMIZER_API_URL/openapi.json -o src/lib/api/optimizer.generated.ts'"
  },
